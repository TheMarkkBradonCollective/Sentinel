# GitHub OAuth App credentials (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Generate a long random value (32+ characters); never commit the real value.
SENTINEL_SESSION_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Postgres. Use the pooled hostname (-pooler) for the app and Worker.
# Copy the direct hostname (no -pooler) to NEON_DATABASE_URL_UNPOOLED for migrations only.
# Never prefix these with NEXT_PUBLIC_. See docs/NEON-MIGRATION.md.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/sentinel?sslmode=require
NEON_DATABASE_URL=
NEON_DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/sentinel?sslmode=require
